PORT=3004
# Separate schema prevents conflicts with other services' migrations.
DATABASE_URL=postgresql://pasarpixel:pasarpixel@postgres:5432/pasarpixel?schema=blockchain
AUTH_SERVICE_URL=http://auth-service:3001
# Exact frontend origin used in wallet challenges. Compose overrides this on EC2.
CLIENT_URL=http://localhost:5173
MAIN_API_URL=http://main-api:3002
PUBLIC_API_URL=http://localhost:8000
# Enable only after creating and funding the dedicated Devnet sponsor wallet.
MINT_ENABLED=false
SOLANA_RPC_URL=https://api.devnet.solana.com
PLATFORM_WALLET_FILE=.secrets/devnet-sponsor.json
MAX_MINT_COST_LAMPORTS=30000000
# Same random secret (at least 32 characters) in auth-service, main-api and blockchain-service.
INTERNAL_SERVICE_TOKEN=
# Enable only AFTER deploying and initializing the purchase program on Devnet.
PURCHASE_ENABLED=false
PURCHASE_PROGRAM_ID=2HpUk2sbKNzheHtEYXxiDVF7hPCEE2bZrhzctYhCUdjJ
# Defaults to the sponsor address; fixed when the on-chain configuration is initialized.
PLATFORM_TREASURY_ADDRESS=
