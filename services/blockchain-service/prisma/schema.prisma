generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Wallet {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique // references Auth Service user ID (no FK across services)
  address   String   @unique
  verifiedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  masterNfts         MasterNft[]
  licenseNfts        LicenseNft[]
  sellerTransactions BlockchainTransaction[] @relation("SellerWallet")
  buyerTransactions  BlockchainTransaction[] @relation("BuyerWallet")

  @@map("wallets")
}

// One current challenge per account, invalidated when a new one is issued.
// No cross-service FK: userId is supplied by auth-service.
model WalletChallenge {
  id         String    @id @default(cuid())
  userId     Int       @unique
  address    String
  message    String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  @@map("wallet_challenges")
}

model MasterNft {
  id            Int      @id @default(autoincrement())
  ownerWalletId Int
  assetId       Int      @unique // references Main API asset ID (no FK across services)
  assetAddress  String   @unique @map("mintAddress")
  mintReference String   @unique @default(uuid())
  ownerAddress  String   @default("")
  metadataUri   String   @default("")
  name          String   @default("")
  manifestHash  String   @default("")
  status        MasterMintStatus @default(PREPARING)
  authorizationId String? @unique
  authorizationMessage String?
  authorizationExpiresAt DateTime?
  authorizedAt DateTime?
  leaseUntil DateTime?
  leaseToken String?
  txSignature String?
  errorMessage String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ownerWallet Wallet     @relation(fields: [ownerWalletId], references: [id])
  licenseNfts LicenseNft[]
  attempts MasterMintAttempt[]

  @@map("master_nfts")
}

enum MasterMintStatus {
  PREPARING
  AWAITING_SIGNATURE
  PENDING
  READY
  FAILED
}

model MasterMintAttempt {
  id Int @id @default(autoincrement())
  masterNftId Int
  signature String @unique
  transaction Bytes
  lastValidBlockHeight BigInt
  status TransactionStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  masterNft MasterNft @relation(fields: [masterNftId], references: [id])

  @@map("master_mint_attempts")
}

model NftMetadata {
  hash String @id
  body String
  createdAt DateTime @default(now())

  @@map("nft_metadata")
}

model LicenseNft {
  id             Int         @id @default(autoincrement())
  masterNftId    Int
  holderWalletId Int
  orderItemId    Int         @unique // references Main API order_item ID (no FK across services)
  mintAddress    String      @unique
  metadataUri    String
  licenseType    LicenseType
  createdAt      DateTime    @default(now())

  masterNft    MasterNft             @relation(fields: [masterNftId], references: [id])
  holderWallet Wallet                @relation(fields: [holderWalletId], references: [id])
  transaction  BlockchainTransaction?

  @@map("license_nfts")
}

enum LicenseType {
  PERSONAL
  COMMERCIAL
}

model BlockchainTransaction {
  id             Int               @id @default(autoincrement())
  licenseNftId   Int               @unique
  sellerWalletId Int
  buyerWalletId  Int
  txSignature    String            @unique
  status         TransactionStatus @default(PENDING)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  licenseNft   LicenseNft @relation(fields: [licenseNftId], references: [id])
  sellerWallet Wallet     @relation("SellerWallet", fields: [sellerWalletId], references: [id])
  buyerWallet  Wallet     @relation("BuyerWallet", fields: [buyerWalletId], references: [id])

  @@map("blockchain_transactions")
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  FAILED
}
